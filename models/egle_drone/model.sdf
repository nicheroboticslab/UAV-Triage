<?xml version="1.0" encoding="UTF-8"?>
<!-- EGLe drone: PX4 x500 with PX4's stabilised 3-axis camera gimbal (E3).
     Same composition as PX4-gazebo-models x500_gimbal; the model name differs,
     so PX4 must start with PX4_GZ_MODEL_NAME=egle_drone and the gz_x500_gimbal
     target (airframe 4019 sets the MNT_* gimbal parameters).
     PX4's GZGimbal publishes /model/egle_drone/command/gimbal_{roll,pitch,yaw}
     and reads link camera_link / sensor camera_imu; the camera sensor is
     "camera" on camera_link, which camera_view.py finds automatically.
     The operator steers pitch/yaw with the right stick (controller_input.py),
     sent to PX4 as MAV_CMD_DO_GIMBAL_MANAGER_PITCHYAW (px4_battery_display.py). -->
<sdf version="1.9">
  <model name="egle_drone">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://gimbal</uri>
      <pose>0 0 0.26 0 0 3.14</pose>
    </include>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>
  </model>
</sdf>
