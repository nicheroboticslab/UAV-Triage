<?xml version="1.0" encoding="UTF-8"?>
<!-- EGLe drone: PX4 x500 with a forward camera pitched 45 degrees down (E3).
     Based on PX4-gazebo-models x500_mono_cam_down (pitch 1.5707 = straight down).
     Future: replace the fixed joint with a gimbal for operator-controlled tilt. -->
<sdf version="1.9">
  <model name="egle_drone">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://mono_cam</uri>
      <pose>0.12 0 0.05 0 0.7854 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0.12 0 0.05 0 0.7854 0</pose>
    </joint>
  </model>
</sdf>
